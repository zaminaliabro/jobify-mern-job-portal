{
  "name": "jobify-server",
  "version": "1.0.0",
  "description": "Jobify - MERN Job Portal backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "@prisma/client": "6.16.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "prisma": "6.16.2"
  }
}
