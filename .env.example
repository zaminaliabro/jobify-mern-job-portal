PORT=5000

# Supabase -> Project Settings -> Database -> Connection string.
# Use the session-mode pooler host (aws-0-<region>.pooler.supabase.com:5432).
# The direct db.<ref>.supabase.co host is IPv6-only and unreachable from many
# networks, and the transaction pooler on 6543 stalls migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Only needed when the API is served from a different origin than the client.
# On Vercel they share an origin, so leave this empty.
CLIENT_URL=http://localhost:5173
